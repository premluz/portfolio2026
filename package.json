{
  "name": "prem-liquid-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --watch deploy/node-server.mjs --dev",
    "dev:local": "node --env-file=.env --watch deploy/node-server.mjs --dev",
    "images": "python3 scripts/optimise-images.py && node scripts/build-backgrounds.mjs",
    "check:images": "node scripts/check-images.mjs",
    "memory:index": "node scripts/memory.mjs index",
    "memory:check": "node scripts/memory.mjs check",
    "memory:search": "node scripts/memory.mjs search",
    "memory:next": "node scripts/memory.mjs next",
    "memory:task": "node scripts/memory.mjs task",
    "memory:mcp": "node scripts/memory-mcp.mjs",
    "build": "npm run check:images && npm run build:settings && node scripts/build-content.mjs && node scripts/build-worker.mjs",
    "build:settings": "node scripts/build-settings.mjs",
    "check": "node scripts/check.mjs",
    "start": "node deploy/node-server.mjs",
    "start:local": "node --env-file=.env deploy/node-server.mjs",
    "test:visual": "playwright test",
    "test:flash": "playwright test tests/visual/screencast.spec.mjs && python3 scripts/check-flash-frames.py",
    "vendor": "node scripts/vendor-three.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "three": "0.170.0"
  }
}
