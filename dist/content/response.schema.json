{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio answer",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "cards"
        },
        "documentIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 120
          }
        }
      },
      "required": [
        "type",
        "documentIds"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "citations": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "documentId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "maxLength": 120
              },
              "evidenceId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "maxLength": 120
              }
            },
            "required": [
              "documentId"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "text",
        "citations"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "mixed"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "documentIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 120
          }
        },
        "citations": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "documentId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "maxLength": 120
              },
              "evidenceId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "maxLength": 120
              }
            },
            "required": [
              "documentId"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "text",
        "documentIds",
        "citations"
      ],
      "additionalProperties": false
    }
  ]
}
